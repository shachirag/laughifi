type Friend {
  id: ID!
  name: String!
  image: String!
  status: Boolean!
}

type FriendLaughifiUsers {
  id: ID!
  name: String!
  image: String!
  status: Boolean!
  getRequest: Boolean!
}

type FriendPaginationResponse {
  total: Int!
  perPage: Int!
  currentPage: Int!
  totalPages: Int!
  friends: [Friend!]!
}

type LaughifiUserPaginationResponse {
  total: Int!
  perPage: Int!
  currentPage: Int!
  totalPages: Int!
  users: [FriendLaughifiUsers!]!
}

extend type Query {
  getLaughifiUsers(
    page: Int!
    limit: Int!
    search: String
  ): LaughifiUserPaginationResponse!
  getFriends(page: Int!, limit: Int!, search: String): FriendPaginationResponse!
  getFriendsRequests: [Friend!]!
}

extend type Mutation {
  updateStatus(userId: ID!, input: UpdateStatusRequestInput!): Response!
  sendFriendRequest(input: SendFriendRequestInput!): RequestResponse!
  cancelFriendRequest(input: SendFriendRequestInput!): Response!
}

input SubscriptionRequestInput {
  id: ID!
  connection: Boolean!
}

type RequestResponse {
  message: String!
}

input UpdateStatusRequestInput {
  Status: String!
}

input SendFriendRequestInput {
  userId: ID!
}
